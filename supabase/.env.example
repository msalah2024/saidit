# OAuth provider secrets for LOCAL Supabase auth.
# Copy this file to `supabase/.env` (git-ignored) and fill in real values.
# The Supabase CLI auto-loads `supabase/.env` and substitutes these into config.toml
# via env(...) references. After editing, restart the stack:
#   npx supabase stop && npx supabase start
#
# Get Google credentials:  Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Get Discord credentials: Discord Developer Portal -> Your App -> OAuth2
#
# In BOTH provider consoles, add this Authorized redirect URI:
#   http://127.0.0.1:54321/auth/v1/callback

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
